# Copy to .streamlit/secrets.toml. Used by "My API (preconfigured key)" in step 2.
# secrets.toml is git-ignored; never commit it. Restart the app after editing.

LLM_PROVIDER = "anthropic"        # anthropic | openai | gemini | openai_compatible
LLM_MODEL    = "claude-opus-5-5"
# LLM_API_KEY = "paste-your-key-here"   # uncomment and paste your key (or set the LLM_API_KEY env var)
# LLM_BASE_URL = "https://.../v1"  # only for openai_compatible
# LLM_BACKUP_MODEL = ""             # optional: same-provider model(s), comma-separated, used when the main one is overloaded

# Optional: people must enter this password before they can use your key ("" = no password)
# MY_API_PASSWORD = "choose-a-password"

# Usage limits for your key (one "request" = one LLM call; Generate SQL may use up to 3, Analyze uses 1)
MY_API_MAX_REQUESTS_PER_SESSION = 30
MY_API_MAX_TOKENS_PER_SESSION   = 300000
MY_API_MAX_REQUESTS_PER_DAY     = 300       # whole app, all users, resets at midnight UTC
MY_API_MAX_TOKENS_PER_DAY       = 3000000   # whole app
MY_API_MAX_USD_PER_DAY          = 10.0      # estimated spend cap (Claude models only); 0 = off
MY_API_MAX_OUTPUT_TOKENS        = 12000     # per LLM response
